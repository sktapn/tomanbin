# Porta da API
PORT=5001

# String de conexão do MongoDB (local ou MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/tomanbin

# Segredo usado para assinar os tokens JWT (troque por algo grande e aleatório)
# Gere um segredo forte com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio
JWT_EXPIRES_IN=1d

# URL do frontend (CORS e Socket.io)
CLIENT_URL=http://localhost:5173

# Admin criado pelo "npm run seed"
ADMIN_EMAIL=admin@tomanbin.com
ADMIN_PASSWORD=admin123

# Fotos dos produtos: cole a "API environment variable" do Cloudinary (cloudinary://...).
# Sem isso, as fotos ficam salvas em server/public/uploads (só serve para desenvolvimento).
CLOUDINARY_URL=

# Endereço público da API (usado nas URLs das imagens)
API_PUBLIC_URL=http://localhost:5001

# Pagamento: 'mercadopago', 'asaas' ou 'demo' (Pix de demonstração, sem gateway).
# Se vazio: usa o gateway que tiver chave configurada; senão, demonstração.
PAYMENT_PROVIDER=

# Mercado Pago (Pix). Só o Access Token (Suas integrações > sua aplicação > Credenciais de teste)
MERCADOPAGO_ACCESS_TOKEN=
# sandbox (teste) | production
MERCADOPAGO_ENV=sandbox
# Assinatura secreta dos webhooks (Suas integrações > Webhooks). Recomendado em produção.
MERCADOPAGO_WEBHOOK_SECRET=

# Asaas (Pix). Use a chave do Sandbox (começa com $aact_hmlg_) para testar
ASAAS_API_KEY=
# sandbox | production (se vazio, é detectado pela chave)
ASAAS_ENV=sandbox

# Frete fixo (R$) e informação de retirada
SHIPPING_FEE=15
PICKUP_INFO=Retirada combinada com a Tomanbin após a confirmação do pagamento (avisamos por e-mail).

# Segurança (opcionais)
AUTH_RATE_LIMIT=10            # tentativas de login/cadastro por IP a cada 15 min
API_RATE_LIMIT=300            # requisições por IP por minuto
MAX_PENDING_ORDERS=3          # pedidos aguardando pagamento por cliente
PENDING_ORDER_TTL_HOURS=24    # pedidos não pagos são cancelados depois disso
